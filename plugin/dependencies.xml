<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_dependencies</name>
    <version>0.1.0</version>
    <creationDate>2026-10</creationDate>
    <author>Herman Peeren</author>
    <authorEmail>herman@yepr.nl</authorEmail>
    <authorUrl>https://github.com/HermanPeeren/joomla-dependencies</authorUrl>
    <copyright>(C) 2026 Herman Peeren</copyright>
    <license>GPL-3.0-or-later</license>
    <description>PLG_SYSTEM_DEPENDENCIES_XML_DESCRIPTION</description>
    <namespace path="src">JoomlaDependencies\Plugin\System\Dependencies</namespace>
    <scriptfile>script.php</scriptfile>
    <dependencies>
        <dependency type="joomla" version="^6.0" />
        <dependency type="php" version="&gt;=8.3" />
    </dependencies>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <files>
        <folder plugin="dependencies">services</folder>
        <folder>language</folder>
        <folder>sql</folder>
        <folder>tmpl</folder>
        <folder>src</folder>
        <folder>vendor-prefixed</folder>
        <filename>autoload.php</filename>
        <filename>script.php</filename>
    </files>
</extension>
